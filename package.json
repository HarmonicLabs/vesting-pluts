{
  "name": "vesting-pluts",
  "version": "0.0.1",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "rm -rf ./dist && tsc -p ./tsconfig.json && tsc-alias -p ./tsconfig.json && npm run rename:cjs",
    "build:light": "tsc -p ./tsconfig.json && tsc-alias -p ./tsconfig.json",
    "rename:cjs": "mv dist/test/testE2E.js dist/test/testE2E.cjs",
    "start": "npm run build && node dist/index.js",
    "vesting:compile": "npm run start",
    "vesting:setup": "npm run build:light && node dist/app/utils/setup.js",
    "vesting:genKeys": "npm run build:light && node dist/app/utils/genKeys.js",
    "vesting:returnFaucet": "npm run build:light && node dist/app/offchain/returnFaucet.js",
    "vesting:create": "npm run build:light && node dist/app/offchain/createVesting.js",
    "vesting:claim": "npm run build:light && node dist/app/offchain/claimVesting.js",
    "test:emulator": "npm run build:light && node dist/test/testE2E.cjs --emulator",
    "test:blockfrost": "npm run build:light && node dist/test/testE2E.cjs",
    "test:emulator:returnFaucet": "npm run build:light && node dist/test/testE2E.cjs --emulator --returnFaucet",
    "test:blockfrost:returnFaucet": "npm run build:light && node dist/test/testE2E.cjs --returnFaucet"
  },
  "dependencies": {
    "@harmoniclabs/blockfrost-pluts": "^0.1.16",
    "@harmoniclabs/buildooor": "^0.1.10",
    "@harmoniclabs/pebble": "^0.1.2",
    "@harmoniclabs/pluts-emulator": "^0.0.1-dev9",
    "blakejs": "^1.2.1",
    "dotenv": "^16.5.0"
  },
  "devDependencies": {
    "@types/node": "^18.15.11",
    "tsc-alias": "^1.7.1",
    "typescript": "^4.8.4"
  }
}
